# Production environment for docker-compose-prod.yml. Copy to .env.prod on the host and fill in.
#
#   docker compose -f docker-compose-prod.yml --env-file .env.prod up -d
#
# Everything here is FF_-prefixed so this app's config cannot collide with anything else sharing the
# host. docker-compose-prod.yml maps each one onto the plain name the app actually reads, so the
# prefix stops at the compose file -- do not add it to .env, launchSettings, or any code.
#
# There is no {NAME}_LOCAL here. That convention only applies to Debug builds, and the images are
# built Release, so a _LOCAL variable in production does nothing at all.

# --- Hostnames -----------------------------------------------------------
# Both must resolve to whatever fronts the Traefik `web` entrypoint (:4322).
FF_WEB_HOST=fantasytools.stephenweaver.dev
FF_API_HOST=fantasytools-api.stephenweaver.dev

# Image tag to run. `latest` tracks stable releases; use `alpha-latest` for pre-releases,
# or pin an exact tag like v1.2.0 to stop Watchtower moving you.
FF_IMAGE_TAG=latest

# --- Auth ----------------------------------------------------------------
# At least 32 characters. Rotating this invalidates every issued token.
FF_JWT_SECRET=

# --- Storage -------------------------------------------------------------
FF_FILE_SERVICE=R2
# Key prefix inside the bucket. A Windows path here would be taken literally -- these containers
# are Linux and the value is an object key, not a directory.
FF_DOCUMENTS_FOLDER=documents

FF_R2_CONNECTION_STRING=https://<account>.r2.cloudflarestorage.com
FF_R2_ACCESS_KEY=
FF_R2_SECRET_KEY=
FF_R2_BUCKET=fantasytools

# --- Card artwork --------------------------------------------------------
FF_IMAGE_SERVICE=R2
# Key prefix inside the images bucket, same as FF_DOCUMENTS_FOLDER above -- an object key, not a path.
FF_IMAGES_FOLDER=cards

# A second bucket, separate from FF_R2_BUCKET and public-read: browsers fetch these objects
# directly rather than through the API. The credentials above are reused as-is.
FF_IMAGES_BUCKET=fantasytools-images

# The public host bound to that bucket. Uploaded artwork URLs are this + "/" + the object key, so a
# wrong value here produces cards whose images 404 while everything else looks fine.
FF_IMAGES_BASE_URL=https://images.fantasytools.stephenweaver.dev

# --- Cloudflare Turnstile ------------------------------------------------
# Add both hostnames above to the widget's allowed domains.
# These are FF_-prefixed like everything else. A _LOCAL suffix does nothing here (Release build), and
# the plain names are what docker-compose-prod.yml expands -- with the wrong name the API starts with
# no secret key and refuses to boot.
FF_TURNSTILE_SITE_KEY=
FF_TURNSTILE_SECRET_KEY=

# --- Email ---------------------------------------------------------------
# Resend (https://resend.com). Key starts with "re_".
FF_RESEND_API_KEY=

# The sending domain must be verified in the Resend dashboard. An unverified address fails at send
# time with a 403, which shows up as registration being broken while the rest of the app is fine.
FF_MAIL_FROM_EMAIL=noreply@email.fantasytools.stephenweaver.dev
FF_MAIL_FROM_NAME=Fantasy Tools

# resend | outbox | both. Anything but resend means verification links never reach a user, since the
# outbox folder is inside a container with no volume behind it.
FF_MAIL_TRANSPORT=resend
