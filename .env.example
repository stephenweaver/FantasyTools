# StockWatch convention: the plain variable is the prod value, {NAME}_LOCAL wins in Debug builds
# (EnvironmentHelper.GetVar in StephenWeaver.Common). A real environment variable beats this file
# entirely -- Program.cs loads it with Env.NoClobber().

# --- Storage -------------------------------------------------------------
# "R2" for Cloudflare R2, anything else for local disk
FILE_SERVICE=R2
FILE_SERVICE_LOCAL=local

# Root folder / key prefix for documents
DOCUMENTS_FOLDER=documents
DOCUMENTS_FOLDER_LOCAL=C:\FantasyTools\Documents

# Cloudflare R2 (prod)
R2_CONNECTION_STRING=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=fantasytools

# --- Auth ----------------------------------------------------------------
# Must be at least 32 characters
JWT_SECRET=change-me-to-a-long-random-value-at-least-32-chars

# Where the verification links point
APP_URL=https://fantasytools.example
APP_URL_LOCAL=http://localhost:5173

# --- Cloudflare Turnstile ------------------------------------------------
# From the Turnstile dashboard. Add localhost to the widget's allowed domains for local dev.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Set to the literal "false" to skip captcha checks entirely and hide the widget. Turnstile will not
# auto-solve for an automated browser, so the e2e suite runs this way -- see the "e2e" launch profile.
# Anything else (including unset or misspelled) leaves the captcha ON.
# TURNSTILE_ENABLED=false

# --- Email ---------------------------------------------------------------
# Sent through IMailerSendService from StephenWeaver.Common.
MAILERSEND_API_KEY=
MAIL_FROM_EMAIL=noreply@fantasytools.example
MAIL_FROM_NAME=Fantasy Tools

# mailersend | outbox | both. Defaults to mailersend when MAILERSEND_API_KEY is set, outbox otherwise.
# "outbox" writes the rendered message to a folder instead of sending, which is what lets a fresh
# clone complete the verification loop with no mail credentials at all.
MAIL_TRANSPORT_LOCAL=outbox
MAIL_OUTBOX_FOLDER_LOCAL=C:\FantasyTools\Outbox

# --- Build ---------------------------------------------------------------
# Only needed for `dotnet restore` against GitHub Packages.
# Classic PAT with read:packages. Set it as a real environment variable --
# nuget.config expands %GITHUB_PACKAGES_TOKEN% from the process environment,
# it does NOT read this file.
GITHUB_PACKAGES_TOKEN=
